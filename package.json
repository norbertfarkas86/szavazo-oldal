{
  "name": "szuloi-bal-react-vite",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "dev:api": "wrangler pages dev dist --port 8788",
    "db:init": "wrangler d1 execute szavazas-db --config wrangler.local.toml --local --file ./schema.sql",
    "db:check": "wrangler d1 execute szavazas-db --config wrangler.local.toml --local --command \"SELECT choice, COUNT(*) AS votes FROM votes GROUP BY choice\""
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.1.0",
    "wrangler": "^4.45.0"
  }
}
